# Supabase — obrigatórias no modo básico (valores públicos)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Aceita a Publishable key atual (sb_publishable_...) ou a chave anon legada.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# URL canônica da aplicação — obrigatória para metadados e callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Netlify inicial: https://SEU-SITE.netlify.app
# Produção após vincular o domínio: https://clickcatalogo.com

# Demonstração pública somente leitura — opcional; habilitada por padrão
DEMO_ACCESS_ENABLED=true

# Chave estável das Server Actions entre instâncias/deploys (32 bytes em base64)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Identificação pública do fornecedor — obrigatória antes da primeira venda
# Não use NEXT_PUBLIC_: os valores são lidos no servidor e renderizados nos documentos legais.
LEGAL_BUSINESS_NAME=
LEGAL_TAX_ID=
LEGAL_POSTAL_ADDRESS=
LEGAL_SUPPORT_EMAIL=

# Supabase Admin — opcional sem Asaas; somente servidor
# Aceita uma Secret key atual (sb_secret_...) ou a service_role legada.
# Nunca use NEXT_PUBLIC_ neste valor.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — necessário para a retomada de cadastro em outro dispositivo.
# Use uma API key restrita ao envio e um remetente do domínio verificado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ClickCatálogo <contato@clickcatalogo.com>

# Asaas — somente servidor
ASAAS_API_KEY=
# Segredo próprio do webhook (32 a 255 caracteres), diferente da API key.
ASAAS_WEBHOOK_TOKEN=
# Opcional para chaves legadas. Chaves atuais hmlg/prod selecionam a URL automaticamente.
ASAAS_API_URL=
# O checkout recorrente atual usa cartão de crédito. PIX recorrente exige outro fluxo.
