{
  "name": "click-catalogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run check:contrast",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "test": "tsx --test tests/account-continuation.test.ts tests/asaas-client.test.ts tests/asaas-payments.test.ts tests/billing-state.test.ts tests/currency.test.ts tests/database-invariants.test.ts tests/rate-limit-policy.test.ts tests/recovery-token.test.ts tests/tenant-boundaries.test.ts tests/webhook-security.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "audit:live": "node --env-file-if-exists=.env.local scripts/audit-live.mjs",
    "audit:asaas": "node --env-file-if-exists=.env.local scripts/audit-asaas.mjs",
    "audit:production": "node --env-file-if-exists=.env.local scripts/audit-production.mjs",
    "backup:storage": "node --env-file-if-exists=.env.local scripts/backup-storage.mjs",
    "privacy:purge": "node --env-file-if-exists=.env.local scripts/purge-retention.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
